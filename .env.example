# ═══════════════════════════════════════════════════════════════
#  Yarijoo Platform V2 — Environment Variables
#  Copy this file to .env and fill in all required values.
#  Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────
# General
# ───────────────────────────────────────────────

# Application environment: development | production | test
NODE_ENV=development

# Public URLs (used by frontend & CORS)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# ───────────────────────────────────────────────
# Database (PostgreSQL 16)
# ───────────────────────────────────────────────

# Full Prisma-compatible connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://yarijoo:CHANGE_ME@localhost:5432/yarijoo

# Individual DB credentials (used by docker-compose)
POSTGRES_DB=yarijoo
POSTGRES_USER=yarijoo
DB_PASSWORD=CHANGE_ME

# ───────────────────────────────────────────────
# Redis 7
# ───────────────────────────────────────────────

# Full Redis connection URL (used by backend services & BullMQ)
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# Redis AUTH password (must match REDIS_URL password above)
REDIS_PASSWORD=CHANGE_ME

# ───────────────────────────────────────────────
# MinIO (S3-compatible object storage)
# ───────────────────────────────────────────────

# MinIO API endpoint (without trailing slash)
MINIO_ENDPOINT=http://localhost:9000

# MinIO root credentials (also set as MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_SECRET_MIN_8_CHARS

# Default bucket name for user-uploaded files
MINIO_BUCKET=yarijoo-files

# ───────────────────────────────────────────────
# JWT & Authentication
# ───────────────────────────────────────────────

# Secret key for signing access tokens — must be long and random
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Secret key for signing refresh tokens — must differ from JWT_SECRET
REFRESH_SECRET=CHANGE_ME_ANOTHER_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Access token lifetime (ms / zeit/ms format)
JWT_EXPIRES_IN=15m

# Refresh token lifetime
REFRESH_EXPIRES_IN=7d

# ───────────────────────────────────────────────
# Kavenegar SMS Gateway
# ───────────────────────────────────────────────

# API key from your Kavenegar account dashboard
KAVENEGAR_API_KEY=CHANGE_ME

# ───────────────────────────────────────────────
# Zarinpal Payment Gateway
# ───────────────────────────────────────────────

# Merchant ID provided by Zarinpal (36-char UUID format)
ZARINPAL_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# ───────────────────────────────────────────────
# OpenAI (AI Test Analysis)
# ───────────────────────────────────────────────

# OpenAI API key for GPT-4 powered test result analysis
OPENAI_API_KEY=sk-CHANGE_ME
