// =============================================================================
// Yarijoo Platform V2 — Prisma Schema
// PostgreSQL 16 | Generated by Kiro
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  USER
  PSYCHOLOGIST
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionLevel {
  FREE
  SILVER
  GOLD
  PLATINUM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ScoringType {
  SUM
  WEIGHTED
  SUBSCALE
  CUSTOM
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SCALE
  TEXT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// =============================================================================
// AUTH & USERS
// =============================================================================

model User {
  id                  String            @id @default(uuid())
  phone               String            @unique
  email               String?           @unique
  fullName            String?           @map("full_name")
  avatarUrl           String?           @map("avatar_url")
  role                UserRole          @default(USER)
  subscriptionLevel   SubscriptionLevel @default(FREE) @map("subscription_level")
  isVerified          Boolean           @default(false) @map("is_verified")
  isSuspended         Boolean           @default(false) @map("is_suspended")
  notificationPrefs   Json?             @map("notification_prefs")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  // Relations
  refreshTokens       RefreshToken[]
  testAttempts        UserTestAttempt[]
  orders              Order[]
  appointments        Appointment[]           @relation("UserAppointments")
  chatRooms           ChatRoomMember[]
  notifications       Notification[]
  tickets             Ticket[]
  subscriptions       Subscription[]
  bookmarks           Bookmark[]
  reviews             Review[]
  psychologistProfile PsychologistProfile?
  courseEnrollments   CourseEnrollment[]
  lessonProgress      LessonProgress[]
  bookProgress        UserBookProgress[]
  searchLogs          SearchLog[]
  auditLogs           AuditLog[]              @relation("AdminAuditLogs")
  storyViews          StoryView[]
  comments            Comment[]

  @@index([phone])
  @@index([role])
  @@index([subscriptionLevel])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@index([phone, used])
  @@map("otp_codes")
}

// =============================================================================
// TESTS ENGINE
// =============================================================================

model Test {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  description String?
  category    String
  scoringType ScoringType @map("scoring_type")
  config      Json        @default("{}") // custom scoring config
  isPremium   Boolean     @default(false) @map("is_premium")
  imageUrl    String?     @map("image_url")
  status      TestStatus  @default(DRAFT)
  duration    Int?        // minutes estimate
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  questions       TestQuestion[]
  attempts        UserTestAttempt[]
  interpretations TestInterpretation[]

  @@index([category])
  @@index([isPremium])
  @@index([status])
  @@index([slug])
  @@map("tests")
}

model TestQuestion {
  id            String       @id @default(uuid())
  testId        String       @map("test_id")
  text          String
  order         Int
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json         @default("[]") // [{value, label, score}]
  scoringWeight Float        @default(1.0) @map("scoring_weight")
  subscaleKey   String?      @map("subscale_key")

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([testId, order])
  @@map("test_questions")
}

model UserTestAttempt {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  testId            String    @map("test_id")
  answers           Json      @default("{}") // {questionId: selectedValue}
  score             Json      @default("{}") // {total, subscales, normalized}
  status            String    @default("in_progress") // in_progress | completed | abandoned
  aiRecommendations Json?     @map("ai_recommendations")
  aiGeneratedCount  Int       @default(0) @map("ai_generated_count")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id])

  @@index([userId])
  @@index([testId])
  @@index([userId, testId])
  @@index([userId, status])
  @@map("user_test_attempts")
}

model TestInterpretation {
  id                 String  @id @default(uuid())
  testId             String  @map("test_id")
  scoreRangeMin      Float   @map("score_range_min")
  scoreRangeMax      Float   @map("score_range_max")
  subscaleKey        String? @map("subscale_key")
  interpretationText String  @map("interpretation_text")
  severity           String? // low | medium | high | critical
  recommendations    Json    @default("[]")

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("test_interpretations")
}

// =============================================================================
// CONTENT: BLOG, BOOKS, STORIES, CATEGORIES
// =============================================================================

model Category {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  type     String  // blog | book | test | course | product
  parentId String? @map("parent_id")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  blogPosts BlogPost[]
  books     Book[]
  courses   Course[]

  @@index([type])
  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model BlogPost {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  excerpt     String?
  content     String        // rich HTML
  coverImage  String?       @map("cover_image")
  authorId    String        @map("author_id")
  categoryId  String?       @map("category_id")
  status      ContentStatus @default(DRAFT)
  isPremium   Boolean       @default(false) @map("is_premium")
  views       Int           @default(0)
  readTime    Int?          @map("read_time") // minutes
  tags        String[]      @default([])
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category  Category?  @relation(fields: [categoryId], references: [id])
  bookmarks Bookmark[]
  comments  Comment[]

  @@index([status])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([slug])
  @@map("blog_posts")
}

model Book {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  author      String
  description String?
  coverImage  String?       @map("cover_image")
  fileUrl     String?       @map("file_url") // MinIO path
  categoryId  String?       @map("category_id")
  isPremium   Boolean       @default(false) @map("is_premium")
  price       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  totalPages  Int?          @map("total_pages")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category     Category?         @relation(fields: [categoryId], references: [id])
  reviews      Review[]
  orderItems   OrderItem[]
  bookProgress UserBookProgress[]
  pages        BookPage[]

  @@index([status])
  @@index([categoryId])
  @@index([slug])
  @@index([isPremium])
  @@map("books")
}

model BookPage {
  id        String   @id @default(uuid())
  bookId    String   @map("book_id")
  title     String
  content   String
  pageOrder Int      @default(0) @map("page_order")
  createdAt DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([bookId, pageOrder])
  @@map("book_pages")
}

model Story {
  id        String        @id @default(uuid())
  title     String?
  content   String
  mediaUrl  String?       @map("media_url")
  authorId  String        @map("author_id")
  expiresAt DateTime?     @map("expires_at")
  views     Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now()) @map("created_at")

  storyViews StoryView[]

  @@index([authorId])
  @@index([status])
  @@index([expiresAt])
  @@map("stories")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  userId   String   @map("user_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
  @@map("story_views")
}

model Comment {
  id         String        @id @default(uuid())
  blogPostId String        @map("blog_post_id")
  userId     String        @map("user_id")
  content    String
  status     ContentStatus @default(DRAFT) // DRAFT = pending approval
  createdAt  DateTime      @default(now()) @map("created_at")

  blogPost BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogPostId])
  @@index([userId])
  @@index([blogPostId, status])
  @@map("comments")
}

// =============================================================================
// COURSES
// =============================================================================

model Course {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  description    String?
  instructorId   String        @map("instructor_id")
  thumbnail      String?
  price          Int           @default(0)
  salePrice      Int?          @map("sale_price")
  categoryId     String?       @map("category_id")
  status         ContentStatus @default(DRAFT)
  duration       Int?          // total minutes
  totalLessons   Int           @default(0) @map("total_lessons")
  enrolledCount  Int           @default(0) @map("enrolled_count")
  rating         Float?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  category    Category?          @relation(fields: [categoryId], references: [id])
  lessons     CourseLesson[]
  enrollments CourseEnrollment[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([instructorId])
  @@map("courses")
}

model CourseLesson {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  title     String
  videoUrl  String?  @map("video_url")
  duration  Int?     // seconds
  order     Int
  isFree    Boolean  @default(false) @map("is_free")
  createdAt DateTime @default(now()) @map("created_at")

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId])
  @@index([courseId, order])
  @@map("course_lessons")
}

model CourseEnrollment {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  courseId          String   @map("course_id")
  enrolledAt        DateTime @default(now()) @map("enrolled_at")
  completionPercent Float    @default(0) @map("completion_percent")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  lessonId        String    @map("lesson_id")
  watchedSeconds  Int       @default(0) @map("watched_seconds")
  percentComplete Float     @default(0) @map("percent_complete")
  completedAt     DateTime? @map("completed_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model UserBookProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  lastPage  Int      @default(0) @map("last_page")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("user_book_progress")
}

// =============================================================================
// E-COMMERCE & PAYMENTS
// =============================================================================

model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String?
  price       Int      // ریال
  salePrice   Int?     @map("sale_price")
  stock       Int      @default(0)
  images      String[] @default([])
  categoryId  String?  @map("category_id")
  type        String   @default("physical") // physical | digital
  fileUrl     String?  @map("file_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([isActive])
  @@index([categoryId])
  @@index([isActive, categoryId])
  @@index([slug])
  @@map("products")
}

model Order {
  id                  String      @id @default(uuid())
  userId              String      @map("user_id")
  status              OrderStatus @default(PENDING)
  totalAmount         Int         @map("total_amount") // ریال
  zarinpalRefId       String?     @map("zarinpal_ref_id")
  zarinpalAuthority   String?     @map("zarinpal_authority")
  shippingAddress     Json?       @map("shipping_address")
  notes               String?
  discountCodeId      String?     @map("discount_code_id")
  discountAmount      Int         @default(0) @map("discount_amount")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id])
  items        OrderItem[]
  discountCode DiscountCode?  @relation(fields: [discountCodeId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String? @map("product_id")
  bookId    String? @map("book_id")
  courseId  String? @map("course_id")
  quantity  Int     @default(1)
  unitPrice Int     @map("unit_price")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  book    Book?    @relation(fields: [bookId], references: [id])
  course  Course?  @relation(fields: [courseId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([bookId])
  @@index([courseId])
  @@map("order_items")
}

model Subscription {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  plan      SubscriptionLevel
  startDate DateTime          @map("start_date")
  endDate   DateTime          @map("end_date")
  orderId   String?           @map("order_id")
  isActive  Boolean           @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([userId, isActive])
  @@index([endDate])
  @@map("subscriptions")
}

model DiscountCode {
  id         String    @id @default(uuid())
  code       String    @unique
  type       String    // amount | percentage
  amount     Float
  usageLimit Int?      @map("usage_limit")
  usedCount  Int       @default(0) @map("used_count")
  expiresAt  DateTime? @map("expires_at")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  orders Order[]

  @@index([code])
  @@index([isActive])
  @@map("discount_codes")
}

// =============================================================================
// APPOINTMENTS & PSYCHOLOGISTS
// =============================================================================

model PsychologistProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  bio          String?
  specialty    String[]
  licenseNo    String?  @map("license_no")
  hourlyRate   Int?     @map("hourly_rate")
  isVerified   Boolean  @default(false) @map("is_verified")
  isAvailable  Boolean  @default(true) @map("is_available")
  availability Json     @default("{}") // weekly slots
  rating       Float?
  reviewCount  Int      @default(0) @map("review_count")

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@index([isVerified])
  @@index([isAvailable])
  @@map("psychologist_profiles")
}

model Appointment {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  psychologistId String            @map("psychologist_id")
  startTime      DateTime          @map("start_time")
  endTime        DateTime          @map("end_time")
  status         AppointmentStatus @default(PENDING)
  notes          String?
  meetingLink    String?           @map("meeting_link")
  paidAmount     Int?              @map("paid_amount")
  zarinpalAuthority String?        @map("zarinpal_authority")
  zarinpalRefId  String?           @map("zarinpal_ref_id")
  reminderSent   Boolean           @default(false) @map("reminder_sent")
  rating         Int?
  review         String?
  createdAt      DateTime          @default(now()) @map("created_at")

  user         User                @relation("UserAppointments", fields: [userId], references: [id])
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id])

  @@index([userId])
  @@index([psychologistId])
  @@index([userId, status])
  @@index([psychologistId, startTime])
  @@index([status])
  @@map("appointments")
}

// =============================================================================
// CHAT & MESSAGING
// =============================================================================

model ChatRoom {
  id        String   @id @default(uuid())
  type      String   @default("direct") // direct | group
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  members  ChatRoomMember[]
  messages ChatMessage[]

  @@index([type])
  @@map("chat_rooms")
}

model ChatRoomMember {
  id       String   @id @default(uuid())
  roomId   String   @map("room_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("chat_room_members")
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  senderId  String   @map("sender_id")
  content   String
  type      String   @default("text") // text | image | file
  fileUrl   String?  @map("file_url")
  readBy    String[] @map("read_by")
  createdAt DateTime @default(now()) @map("created_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // appointment | payment | message | system
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// SUPPORT TICKETS
// =============================================================================

model Ticket {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  rating    Int?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([priority])
  @@index([updatedAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  content   String
  isAdmin   Boolean  @default(false) @map("is_admin")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

// =============================================================================
// BOOKMARKS & REVIEWS
// =============================================================================

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // blog | book | test | course
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogPost BlogPost? @relation(fields: [targetId], references: [id])

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([targetId])
  @@map("bookmarks")
}

model Review {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // book | psychologist | course
  targetId  String   @map("target_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id])
  book Book? @relation(fields: [targetId], references: [id])

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([targetId])
  @@index([type, targetId])
  @@map("reviews")
}

// =============================================================================
// SEARCH
// =============================================================================

model SearchLog {
  id        String   @id @default(uuid())
  term      String
  userId    String?  @map("user_id")
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([term])
  @@index([userId])
  @@index([count])
  @@map("search_logs")
}

// =============================================================================
// ADMIN & SYSTEM
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String   // create | update | delete | suspend | verify
  entityType String   @map("entity_type") // user | test | blog | order | ...
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("settings")
}
